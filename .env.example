# Copy to .env and fill in. Never commit .env.

# ============================================================
# StockX developer application  <<< PUT YOUR STOCKX KEYS HERE
# (developer.stockx.com -> Applications)
# ============================================================
STOCKX_API_KEY=
STOCKX_CLIENT_ID=
STOCKX_CLIENT_SECRET=
# Long-lived refresh token from the one-time OAuth authorization-code flow
# (scope "offline_access openid", audience gateway.stockx.com).
STOCKX_REFRESH_TOKEN=

# ============================================================
# Notifications — Discord webhook (default method)
# ============================================================
DISCORD_WEBHOOK_URL=

# Telegram (only if notifications.method: telegram in config.yaml)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
